# Local & downloaded provider plugins
**/.terraform/

# State files — contain resource IDs and sometimes secrets
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Override files (local-only overrides, never committed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config that may hold credentials
.terraformrc
terraform.rc
