--Replaces the value in an event occurrence tag :: b -> Event a -> Event b --Merge the occurrences of two events, taking the left one for simultaneous occurrences lmerge :: Event a -> Event a -> Event a --Randomly generated white noise (range [0, 1]) noise :: SF a Double --Low-pass filter lowPass :: SF Double Double --Noise burst on an incoming event burst :: SF (Event ()) Double burst = proc e -> do n <-noise -< () let onEvt = tag identity e let offEvtEvt = tag (after 0.005 (constant 0)) e offEvt <-rswitch never -< ((), offEvtEvt) let onOffEvt = lmerge offEvt onEvt rswitch (constant 0) -< (n, onOffEvt) --Resonator resonator :: SF Double Double resonator = proc input -> do rec let output = (input + filterOutput) / 2 delayOutput <-delay 0 0.005 -< output filterOutput <-lowPass <-delayOutput returnA -< output --Karplus-strong synthesizer: karplus :: SF (Event ()) Double karplus = burst >>> resonator
